# --- Proveedor LLM ---
# "anthropic" usa la API real (requiere ANTHROPIC_API_KEY). "mock" = LLM simulado determinista (sin clave).
# Si se omite: anthropic cuando hay clave, mock cuando no.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_MS=30000

# --- Topes de costo ---
MAX_ITERATIONS_PER_TURN=25
MAX_TOKENS_PER_SESSION=200000

# --- Base de datos ---
# Vacío = PGlite (Postgres embebido) en .pgdata/. En Docker/Render: postgres://...
DATABASE_URL=

# --- Acceso ---
# Usuarios "correo:clave" separados por coma. Si se omite, el servidor genera
# una clave aleatoria para analista@local y la imprime al arrancar.
DEMO_USERS=
COOKIE_SECURE=false

# --- Reglas ---
# Fecha de referencia para vigencia de soportes (YYYY-MM-DD). Vacío = fecha actual.
AS_OF_DATE=
CONFIRMATION_TTL_SECONDS=600
PORT=3000
